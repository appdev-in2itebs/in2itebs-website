# Preview is the default. Set production only for an approved production release.
SITE_ENV=preview
# Approved HTTPS adapter must durably accept the lead before returning HTTP 2xx.
# Keep secrets in .env.local, never in source control or chat.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
# Enable only behind an ingress that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=0
