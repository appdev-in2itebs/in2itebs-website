# Preview is the default. Set production only for an approved production release.
SITE_ENV=preview
# Approved HTTPS adapter must durably accept the lead before returning HTTP 2xx.
# Keep secrets in .env.local, never in source control or chat.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
# Makes the server trust X-Forwarded-For, X-Forwarded-Host and X-Forwarded-Proto.
# Enable only behind an ingress that overwrites all three. The per-address rate limit
# takes the LEFTMOST X-Forwarded-For value, so it is safe only where the ingress
# overwrites the header (Sucuri does). Ingresses that APPEND the connecting IP to
# whatever the client sent (Cloudflare-style) are not eligible: the leftmost value is
# then client-controlled and the per-address limit becomes spoofable. Leave this 0
# unless the overwrite behaviour has been confirmed on the final proxy.
TRUST_PROXY_HEADERS=0
# Extra browser origins allowed to submit the enquiry form (comma-separated), e.g. a staging host.
ALLOWED_ORIGINS=
# Public site origin used for canonical URLs and the enquiry origin allowlist
# (baked in at build time; set it before `next build`).
NEXT_PUBLIC_SITE_URL=https://in2itebs.com
