{
  "name": "in2it-ebs-web",
  "version": "1.0.0",
  "private": true,
  "description": "In2IT EBS corporate website — Next.js App Router",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3107",
    "build": "next build",
    "postbuild": "node scripts/check-build.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3107",
    "lint": "eslint app components content lib tests --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write app components content lib tests scripts",
    "format:check": "prettier --check app components content lib tests scripts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "check:full": "npm run check && npm run build && npm run test:browser"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.41.0",
    "next": "15.5.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^2.4.0",
    "three": "0.186.0",
    "zod": "^3.23.8"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.13",
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.185.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.24",
    "postcss": "^8.5.28",
    "prettier": "3.6.2",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4"
  }
}
